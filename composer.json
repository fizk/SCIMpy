{
    "name": "root/app",
    "description": "test",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Scimpy\\": "lib/"
        }
    },
    "minimum-stability": "dev",
    "require": {
        "psr/http-message": "^2.0@dev",
        "psr/event-dispatcher": "^1.0@dev",
        "antlr/antlr4-php-runtime": "dev-dev"
    },
    "require-dev": {
        "fizk/library": "*",
        "laminas/laminas-httphandlerrunner": "2.15.x-dev"
    },
    "scripts": {
        "lex": "java -jar ./bin/antlr4.jar -Dlanguage=PHP -Xexact-output-dir -o ./lib/Filter/Syntax/ -package \"Scimpy\\Filter\\Syntax\" -visitor -no-listener ./lib/Filter/Grammar/ScimFilter.g4"
    },
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
